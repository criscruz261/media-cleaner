# Generated desktop builds (keep Cargo.lock and Tauri configuration)
/desktop/src-tauri/target/
/desktop/src-tauri/gen/schemas/

# Local application data and recovery files; never publish user media
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*
diagnostics.jsonl*
api-token
.media-cleaner-quarantine/

# Local secrets; sanitized example configurations may be committed
.env
.env.*
!.env.example
!.env.*.example

# OS/editor temporary files (keep shared .vscode settings and tasks)
.DS_Store
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Keep dependency manifests, lockfiles, migrations, and source assets tracked.
