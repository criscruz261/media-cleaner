<resources>
    <style name="AppThemeLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#315F48</item>
        <item name="android:colorControlNormal">#69786D</item>
        <item name="android:textColorPrimary">#233C32</item>
        <item name="android:textColorSecondary">#69786D</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F7F8F5</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/CleanerDialog</item>
    </style>
    <style name="CleanerDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#315F48</item>
        <item name="android:textColorPrimary">#233C32</item>
        <item name="android:textColorSecondary">#69786D</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="AppTheme" parent="AppThemeDark" />
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#93CBA4</item>
        <item name="android:colorControlNormal">#ACB8AE</item>
        <item name="android:textColorPrimary">#E3EEE5</item>
        <item name="android:textColorSecondary">#ACB8AE</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#101712</item>
        <item name="android:navigationBarColor">#19231D</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/dark_canvas</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/CleanerDialogDark</item>
    </style>
    <style name="CleanerDialogDark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#93CBA4</item>
        <item name="android:textColorPrimary">#E3EEE5</item>
        <item name="android:textColorSecondary">#ACB8AE</item>
        <item name="android:windowBackground">@drawable/dialog_surface_dark</item>
        <item name="android:fontFamily">sans</item>
    </style>
</resources>
